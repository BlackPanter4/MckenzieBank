<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mackenzie Bank - Para el pueblo</title>
<style>
body{background:#0a0a0a;color:white;text-align:center;font-family:Arial;padding:20px}
h1{color:#a91e3a;letter-spacing:3px}
.circulo{border:1px solid #a91e3a;padding:8px;margin:6px;border-radius:20px;font-size:13px}
button{width:95%;padding:16px;margin:8px 0;border-radius:12px;border:none;font-weight:bold;font-size:15px}
.btn-white{background:white;color:black}
.btn-gold{background:gold;color:black}
.btn-defensa{background:#222;color:#ffcc00;border:1px solid #ffcc00}
#resultado{margin-top:15px}
.card{background:#111;border:2px solid #a91e3a;border-radius:15px;padding:12px;margin-bottom:15px;text-align:left}
